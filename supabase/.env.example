# Server-side secrets for local `supabase start` / `supabase functions serve`.
# Copy to supabase/.env (git-ignored). In production set them with `supabase secrets set`.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=local-dummy
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=local-dummy
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local-dummy
APP_ENV=development
YOUPI_API_URL=http://host.docker.internal:6100
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_WEBHOOK_SECRET=change-me
KYC_HASH_PEPPER=change-me
